# Local development leaves these unset. The API stays on 127.0.0.1:8787
# and Vite proxies /api and /ws, so login and multiplayer keep using relative URLs.

# Canonical public origin, scheme plus domain only. Example, once the domain exists:
# APP_URL=https://royalchess.com.br
APP_URL=

# Other public origins that should permanently redirect to APP_URL.
# APP_URL_ALIASES=https://www.royalchess.com.br
APP_URL_ALIASES=

# Set by the host. Local default is 8787. Do not point production at a local address.
PORT=8787

# Optional bind address. Production without HOST listens on 0.0.0.0.
# HOST=127.0.0.1

# production enables the proxy header and the public bind address.
# NODE_ENV=production

# Optional directory for royal.db. Unset keeps royal-chess/data.
# On a host with an ephemeral disk, point this at the persistent mount.
# DATA_DIR=/var/data
