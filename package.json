    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "stockfish": "^19.0.1",
    "ws": "^8.18.2",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.22",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
