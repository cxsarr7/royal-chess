{
  "name": "royal-chess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"tsx watch --clear-screen=false server/src/index.ts\" \"vite --host 127.0.0.1 --port 5173\"",
